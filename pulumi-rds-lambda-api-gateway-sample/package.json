        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^5.1.0",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "jest": "^30.5.2",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "pg": "^8.23.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@pulumi/aws": "^7.0.0",
        "@pulumi/pulumi": "^3.113.0",
